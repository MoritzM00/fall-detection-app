# Non-secret settings for the Modal GPU endpoint (deploy/modal_vllm.py).
# Loaded by `make dev-gpu` and `make gpu-warm` before the Git-ignored .env, which
# holds only the proxy auth token (see .env.example) and may override these.
FALL_DETECTION_BACKEND_KIND=vllm
FALL_DETECTION_INFERENCE_BASE_URL=https://moritzm00--fall-detection-vllm-serve.modal.run/v1
FALL_DETECTION_MODAL_APP=fall-detection-vllm
# Qwen3-VL-8B-Thinking runs in its own function (serve_thinking) with its own URL and GPU.
FALL_DETECTION_ADDITIONAL_MODELS='{"qwen3-vl-8b-thinking": {"base_url": "https://moritzm00--fall-detection-vllm-serve-thinking.us-east.modal.run/v1", "modal_function": "serve_thinking", "thinking": true}}'
# Must match --max-model-len in deploy/modal_vllm.py. The API rejects configurations
# whose conservative token estimate exceeds it before any GPU request.
FALL_DETECTION_MAX_MODEL_LEN=8192
# A window sent during a cold start waits for the container (~3 min).
FALL_DETECTION_REQUEST_TIMEOUT_SECONDS=600
